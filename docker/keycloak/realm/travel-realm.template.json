{
  "realm": "travel",
  "enabled": true,
  "displayName": "Travel Booking",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access to Auth Service administration",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Customer",
        "description": "Default customer role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Support",
        "description": "Customer support role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "HotelOwner",
        "description": "Hotel owner role",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "travel-auth-api",
      "name": "Travel Auth API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": true
      ,
      "protocolMappers": [
        {
          "name": "permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "permission",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@travel.local",
      "firstName": "Travel",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__TRAVEL_ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
