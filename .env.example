# Copy this file to .env and replace every value before running Docker Compose.
# Keep .env out of source control. Production deployments should use Docker
# secrets or the platform's secret manager instead.

ASPNETCORE_ENVIRONMENT=Production

POSTGRES_PORT=5432
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=travel_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-postgres-admin-password

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=replace-with-a-long-auth-db-password

HOTEL_DB_NAME=hotel_db
HOTEL_DB_USER=hotel_user
HOTEL_DB_PASSWORD=replace-with-a-long-hotel-db-password

BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=replace-with-a-long-booking-db-password

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=replace-with-a-long-payment-db-password

KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=replace-with-a-long-keycloak-db-password

KEYCLOAK_PORT=8081
KEYCLOAK_REALM=travel
KEYCLOAK_ADMIN_USER=kc_admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-keycloak-admin-password
KEYCLOAK_CLIENT_SECRET=replace-with-a-long-auth-client-secret
TRAVEL_ADMIN_PASSWORD=replace-with-a-long-travel-admin-password

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=travel_messaging
RABBITMQ_PASSWORD=replace-with-a-long-rabbitmq-password
