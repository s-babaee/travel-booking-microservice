{
  "Keycloak": {
    "BaseUrl": "http://keycloak:8080",
    "Realm": "travel"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-public",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "password-forgot": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-public",
        "Match": {
          "Path": "/api/password/forgot"
        }
      },
      "password-reset": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-public",
        "Match": {
          "Path": "/api/password/reset"
        }
      },
      "password-change": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/password/change"
        }
      },
      "auth-profile": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "auth-users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-admin",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "auth-roles": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-admin",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "auth-permissions": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "gateway-admin",
        "Match": {
          "Path": "/api/permissions/{**catch-all}"
        }
      },
      "hotel-hotels": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/api/hotels/{**catch-all}"
        }
      },
      "hotel-room-types": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/api/room-types/{**catch-all}"
        }
      },
      "hotel-amenities": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/api/amenities/{**catch-all}"
        }
      },
      "hotel-uploads": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "flight-flights": {
        "ClusterId": "flight",
        "Match": {
          "Path": "/api/flights/{**catch-all}"
        }
      },
      "flight-routes": {
        "ClusterId": "flight",
        "Match": {
          "Path": "/api/routes/{**catch-all}"
        }
      },
      "flight-airlines": {
        "ClusterId": "flight",
        "Match": {
          "Path": "/api/airlines/{**catch-all}"
        }
      },
      "flight-schedules": {
        "ClusterId": "flight",
        "Match": {
          "Path": "/api/schedules/{**catch-all}"
        }
      },
      "flight-classes": {
        "ClusterId": "flight",
        "Match": {
          "Path": "/api/classes/{**catch-all}"
        }
      },
      "booking-bookings": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "booking-orders": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "booking-admin": {
        "ClusterId": "booking",
        "AuthorizationPolicy": "gateway-admin",
        "Match": {
          "Path": "/api/admin/bookings/{**catch-all}"
        }
      },
      "payment-payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "payment-refunds": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/refunds/{**catch-all}"
        }
      },
      "inventory-api": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "notification-notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notification-templates": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "gateway-admin",
        "Match": {
          "Path": "/api/notification-templates/{**catch-all}"
        }
      },
      "search-api": {
        "ClusterId": "search",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/search"
          }
        ],
        "Order": 50
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "hotel": {
        "Destinations": {
          "hotel": {
            "Address": "http://hotel:8080/"
          }
        }
      },
      "flight": {
        "Destinations": {
          "flight": {
            "Address": "http://flight:8080/"
          }
        }
      },
      "booking": {
        "Destinations": {
          "booking": {
            "Address": "http://booking:8080/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "payment": {
            "Address": "http://payment:8080/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "inventory": {
            "Address": "http://inventory:8080/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "notification": {
            "Address": "http://notification:8080/"
          }
        }
      },
      "search": {
        "Destinations": {
          "search": {
            "Address": "http://search:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
